# SevaPath Environment Configuration

# Database: PostgreSQL URL. If left empty, SQLite (sqlite:///./sevapath.db) will be used automatically.
DATABASE_URL=

# Gemini API Key (for Mission parsing and Match explanations)
GEMINI_API_KEY=

# Authentication Secret and settings
JWT_SECRET=sevapath_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Port
PORT=8000

